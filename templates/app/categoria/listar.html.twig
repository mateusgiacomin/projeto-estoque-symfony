{% extends 'app/base.html.twig' %}

{% block title %}Categorias{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Categorias</h1>
        <a href="{{ path('cadastrar_categoria_show') }}" class="btn btn-primary">Nova categoria</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Nome</th>
                <th scope="col" class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for categoria in categorias %}
                <tr>
                    <th scope="row">{{ categoria.id }}</th>
                    <td>{{ categoria.nome }}</td>
                    <td class="text-end">
                        <a href="{{ path('editar_categoria_show', {id: categoria.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="{{ path('remover_categoria', {id: categoria.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Remover esta categoria?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('remover_categoria_' ~ categoria.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">Nenhuma categoria cadastrada.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}