{% extends 'app/base.html.twig' %}

{% block title %}Nova categoria{% endblock %}

{% block content %}
    <h1 class="mb-4">Nova categoria</h1>

    <form action="{{ path('cadastrar_categoria_salvar') }}" method="post" style="max-width: 480px;">
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" minlength="3" maxlength="50" required>
        </div>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
        <a href="{{ path('listar_categorias') }}" class="btn btn-link">Cancelar</a>
    </form>
{% endblock %}