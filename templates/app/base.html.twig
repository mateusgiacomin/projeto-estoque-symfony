{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block body %}
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app') }}">Estoque</a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app') }}">Painel</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('listar_categorias') }}">Categorias</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('listar_produtos') }}">Produtos</a>
                </li>
            </ul>

            <a class="btn btn-outline-danger btn-sm" href="{{ path('app_logout') }}">Sair</a>
        </div>
    </nav>

    <main class="container py-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>
{% endblock %}
